# Copy to .env.local and fill in real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sellpify
# Public support address (contact page, legal pages) and who runs the site, e.g. "Acme Digital Ltd".
NEXT_PUBLIC_SUPPORT_EMAIL=support@sellpify.com
NEXT_PUBLIC_SITE_OPERATOR=
AUTH_SECRET=

# Owner admin login (email is fixed in lib/owner-admin.js). Signing in with this password re-creates / restores the
# admin account, so it can never be deleted or locked out. Keep it out of git; set it on the server too.
ADMIN_PASSWORD=

# Encrypts sellers' bank/wallet details in the database (AES-256-GCM, lib/field-encryption.js).
# 64 hex characters: openssl rand -hex 32. Use the SAME value everywhere that shares the database, and keep a safe
# copy — if it's lost, encrypted details can't be read. After adding it, run: npm run encrypt:bank-details
DATA_ENCRYPTION_KEY=

# Payment gateway details shown on /legal/payment-policy (merchant reviews ask for them): the processor's name and
# the name buyers see on their card statement, e.g. Stripe / SELLPIFY.COM. Optional.
NEXT_PUBLIC_PAYMENT_PROVIDER=
NEXT_PUBLIC_BILLING_DESCRIPTOR=

# Google reCAPTCHA v2 ("I'm not a robot") on login and sign-up. Create keys at https://www.google.com/recaptcha/admin
# (type: reCAPTCHA v2 → "I'm not a robot" Checkbox; domains: sellpify.com and localhost). Without them the check is off.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Sign-up email rules (lib/email-guard.js). ~9,000 disposable-email domains are blocked out of the box.
# Extra domains to block / domains to always allow, comma-separated, e.g. BLOCKED_EMAIL_DOMAINS=spam.example,junk.test
BLOCKED_EMAIL_DOMAINS=
ALLOWED_EMAIL_DOMAINS=

# Bearer token for admin API routes (min 32 chars): openssl rand -base64 32
ADMIN_API_KEY=

# Signs download tokens. Required (min 32 chars): openssl rand -base64 48
# (AUTH_SECRET above)

# Seller uploads (listing photos, videos, PDF/ZIP files). Create a Blob store in your Vercel project
# (Storage → Blob) and it adds this automatically; on a self-hosted server copy it here.
# Without it, uploads are saved on this server's disk (UPLOAD_DIR, default ./uploads) — not possible on Vercel.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# Local testing only: completes paid orders without a payment provider. NEVER enable in production.
DEMO_CHECKOUT=false

# Pricing (inlined at build time). Tax rate as a decimal, e.g. 0.08 = 8%. Service fee in cents per order.
NEXT_PUBLIC_TAX_RATE=0
NEXT_PUBLIC_SERVICE_FEE_CENTS=0

# Marketplace: platform share of each seller sale (decimal). 0 = no platform fee (default); 0.10 = 10%. Inlined at build time.
NEXT_PUBLIC_COMMISSION_RATE=0
