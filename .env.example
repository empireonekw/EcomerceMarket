# Copy to .env.local and fill in real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sellpify
# Public support address (contact page, legal pages) and who runs the site, e.g. "Acme Digital Ltd".
NEXT_PUBLIC_SUPPORT_EMAIL=support@sellpify.com
NEXT_PUBLIC_SITE_OPERATOR=
AUTH_SECRET=

# Bearer token for admin API routes (min 32 chars): openssl rand -base64 32
ADMIN_API_KEY=

# Signs download tokens. Required (min 32 chars): openssl rand -base64 48
# (AUTH_SECRET above)

# Seller uploads (listing photos, videos, PDF/ZIP files). Create a Blob store in your Vercel project
# (Storage → Blob) and it adds this automatically; on a self-hosted server copy it here.
# Without it, uploads are saved on this server's disk (UPLOAD_DIR, default ./uploads) — not possible on Vercel.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# Local testing only: completes paid orders without a payment provider. NEVER enable in production.
DEMO_CHECKOUT=false

# Pricing (inlined at build time). Tax rate as a decimal, e.g. 0.08 = 8%. Service fee in cents per order.
NEXT_PUBLIC_TAX_RATE=0
NEXT_PUBLIC_SERVICE_FEE_CENTS=0

# Marketplace: platform share of each seller sale (decimal). 0 = no platform fee (default); 0.10 = 10%. Inlined at build time.
NEXT_PUBLIC_COMMISSION_RATE=0
