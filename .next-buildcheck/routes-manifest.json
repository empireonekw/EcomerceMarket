      "statusCode": 308,
      "regex": "^(?!/_next)/seller/products(?:/)?$"
    },
    {
      "source": "/seller/products/add",
      "destination": "/seller/listings/new",
      "statusCode": 308,
      "regex": "^(?!/_next)/seller/products/add(?:/)?$"
    },
    {
      "source": "/seller/products/:id/edit",
      "destination": "/seller/listings/:id/edit",
      "statusCode": 308,
      "regex": "^(?!/_next)/seller/products(?:/([^/]+?))/edit(?:/)?$"
    }
  ],
